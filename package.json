{
  "name": "webbuilder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visual app builder for non-technical creators, with live two-way code sync.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run check:roundtrip && npm run check:app",
    "check:roundtrip": "node scripts/check-roundtrip.mjs",
    "check:app": "esbuild scripts/smoke.jsx --bundle --platform=node --format=esm --jsx=automatic --outfile=node_modules/.cache/smoke.mjs --loader:.css=empty --external:jsdom --log-level=warning && node node_modules/.cache/smoke.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.25.6",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "codemirror": "^6.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.451.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "vite": "^5.4.8"
  }
}
